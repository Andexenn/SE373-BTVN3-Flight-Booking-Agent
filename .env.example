# LLM Provider configuration: "google" or "openai"
LLM_PROVIDER=openai

# Google Gemini API Key (if using google)
GOOGLE_API_KEY=your_google_api_key_here

# OpenAI / OpenAI-compatible API Key (if using openai or openrouter)
OPENAI_API_KEY=your_openai_api_key_here

# Optional base URL for OpenAI-compatible endpoints (e.g., OpenRouter)
OPENAI_BASE_URL=https://openrouter.ai/api/v1

# Model name configuration (e.g., openai/gpt-4o-mini, gpt-4o-mini, gemini-2.0-flash)
OPENAI_MODEL=openai/gpt-4o-mini
MODEL_NAME=openai/gpt-4o-mini
